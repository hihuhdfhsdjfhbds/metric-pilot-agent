# 复制为 .env 并填入你的模型密钥；不配置时自动使用内置规则引擎跑通全链路。

# 选择 LLM：auto（有 Key 用真实模型，否则规则回退）/ openai / rule
METRIC_PILOT_LLM=auto

# OpenAI 兼容协议接入（DeepSeek / 通义千问 DashScope / Moonshot / 本地 Ollama 均可）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
METRIC_PILOT_MODEL=qwen-plus

# 运行参数
METRIC_PILOT_TEMPERATURE=0.0
METRIC_PILOT_MAX_STEPS=6
METRIC_PILOT_TIMEOUT=30
